{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Strict type checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@scenes/*": ["src/scenes/*"],
      "@entities/*": ["src/entities/*"],
      "@systems/*": ["src/systems/*"],
      "@battle/*": ["src/battle/*"],
      "@world/*": ["src/world/*"],
      "@ui/*": ["src/ui/*"],
      "@data/*": ["src/data/*"],
      "@audio/*": ["src/audio/*"],
      "@art/*": ["src/art/*"],
      "@save/*": ["src/save/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["src/config/*"],
      "@inventory/*": ["src/inventory/*"],
      "@shop/*": ["src/shop/*"]
    }
  },
  "include": ["src", "tests"]
}
